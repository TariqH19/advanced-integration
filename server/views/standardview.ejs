<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PayPal Standard Integrations - Demo Gallery</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    :root{color-scheme:light;--ink:#142b45;--muted:#607286;--line:#dfe7ef;--surface:#fff;--page:#f4f7fa;--blue:#0070ba;--blue-dark:#003087;--soft:#eaf3f9;--radius:14px;--shadow:0 8px 24px rgba(20,43,69,.07)}
    *{box-sizing:border-box}
    html{min-width:320px;scroll-behavior:smooth}
    body{margin:0;background:var(--page);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;font-size:15px;line-height:1.55}
    a{color:inherit}
    .navbar{position:sticky;top:0;z-index:1000;min-height:68px;padding:0 clamp(20px,5vw,72px);display:flex;align-items:center;justify-content:space-between;gap:24px;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}
    .navbar .logo{display:inline-flex;align-items:center;gap:11px;color:var(--ink);font-size:1.05rem;font-weight:700;text-decoration:none;letter-spacing:-.02em}
    .navbar .logo i{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:var(--soft);color:var(--blue);font-size:18px}
    .navbar .nav-links{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .navbar .nav-links a{padding:9px 13px;border-radius:8px;color:var(--muted);font-size:.9rem;font-weight:600;text-decoration:none;transition:background .16s ease,color .16s ease}
    .navbar .nav-links a:hover,.navbar .nav-links a:focus-visible{background:var(--soft);color:var(--blue-dark);outline:none}
    .navbar .nav-links a.nav-link-home{background:var(--soft);color:var(--blue-dark)}
    .main-container{width:min(1280px,100%);margin:0 auto;padding:48px clamp(20px,4vw,48px) 72px}
    .page-header,.header-section{max-width:780px;margin:0 auto 36px;text-align:left}
    .page-title,.header-title{margin:0 0 12px;color:var(--ink);font-size:clamp(2rem,4vw,2.8rem);font-weight:700;letter-spacing:-.045em;line-height:1.12;text-shadow:none}
    .page-subtitle,.header-subtitle{max-width:690px;margin:0;color:var(--muted);font-size:1.05rem;line-height:1.7}
    .card-grid,.card-container{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:20px;margin-top:28px}
    .integration-card,.card{position:relative;display:flex;flex-direction:column;min-width:0;padding:26px;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;overflow:hidden}
    .integration-card:hover,.card:hover{transform:translateY(-3px);border-color:#c5d8e8;box-shadow:0 14px 30px rgba(20,43,69,.1)}
    .integration-card:before,.card:before{content:none}
    .card-header{display:flex;align-items:center;gap:14px;margin:0 0 16px}
    .card-icon{flex:0 0 46px;width:46px;height:46px;display:grid;place-items:center;border-radius:11px;background:var(--soft);color:var(--blue);font-size:1.2rem;box-shadow:none}
    .card-title,.card h3{margin:0;color:var(--ink);font-size:1.16rem;font-weight:700;line-height:1.3}
    .card-description,.card p{margin:0 0 20px;color:var(--muted);font-size:.94rem;line-height:1.65}
    .card-features{margin:0 0 22px}
    .feature-list{margin:0;padding:0;list-style:none}
    .feature-item{display:flex;align-items:flex-start;gap:9px;margin:0 0 9px;color:#43576c;font-size:.88rem}
    .feature-item i{margin-top:4px;color:#27815c;font-size:.78rem}
    .card-actions,.card-buttons{display:flex;gap:10px;align-items:center;margin-top:auto}
    .demo-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:10px 15px;border:1px solid var(--blue);border-radius:8px;background:var(--blue);color:#fff;text-align:center;text-decoration:none;font-size:.9rem;font-weight:650;transition:background .16s ease,border-color .16s ease}
    .demo-button:hover,.demo-button:focus-visible{background:var(--blue-dark);border-color:var(--blue-dark);outline:none;transform:none;box-shadow:none}
    .complexity-badge,.difficulty-badge{position:absolute;top:18px;right:18px;padding:4px 9px;border-radius:999px;background:#edf2f6;color:#526579;font-size:.7rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
    .complexity-advanced,.complexity-expert,.complexity-enterprise,.difficulty-beginner,.difficulty-intermediate,.difficulty-advanced{background:#edf2f6;color:#526579}
    .complexity-enterprise{background:#fff4dd;color:#805500}
    .integration-stats{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-start;margin-top:25px}
    .stat-item{min-width:120px;padding:13px 16px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);text-align:left;backdrop-filter:none}
    .stat-number{display:block;font-size:1.4rem;font-weight:750;letter-spacing:-.03em}
    .stat-label{color:var(--muted);font-size:.8rem}
    @media(max-width:720px){.navbar{padding:12px 18px;min-height:auto;align-items:flex-start;flex-direction:column;gap:8px}.navbar .nav-links{width:100%;gap:4px}.navbar .nav-links a{padding:8px 10px}.main-container{padding-top:32px}.integration-card,.card{padding:21px}.card-grid,.card-container{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
  </style>
  <link rel="stylesheet" href="/site.css">
</head>

<body>
  <nav class="navbar">
  <a href="/" class="logo"><i class="fab fa-paypal" aria-hidden="true"></i><span>PayPal Integration Hub</span></a>
  <div class="nav-links" aria-label="Main navigation">
    <a href="/" class="nav-link nav-link-home">Advanced</a>
    <a href="/standardview" class="nav-link">Standard</a>
    <a href="/cards" class="nav-link">Cards</a>
  </div>
</nav>

  <div class="main-container">
    <div class="header-section">
      <h1 class="header-title">
        <i class="fas fa-rocket"></i>
        Standard PayPal Integrations
      </h1>
      <p class="header-subtitle">
        Explore comprehensive PayPal integration examples ready for implementation
      </p>

      <div class="integration-stats">
        <div class="stat-item">
          <span class="stat-number">8</span>
          <span class="stat-label">Integration Types</span>
        </div>


      </div>
    </div>

    <div class="card-container">
      <div class="card">
        <div class="difficulty-badge difficulty-beginner">Beginner</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-shopping-cart"></i>
          </div>
          <h3>Standard Checkout</h3>
        </div>
        <p>
          The most common PayPal integration for simple one-time payments. Perfect for e-commerce stores,
          donations, and basic checkout flows with comprehensive error handling.
        </p>
        <div class="card-features">
          <span class="feature-tag">One-time payments</span>
          <span class="feature-tag">Guest checkout</span>
          <span class="feature-tag">Mobile optimized</span>
        </div>
        <div class="card-buttons">
          <a href="/standard" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-intermediate">Intermediate</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-sync-alt"></i>
          </div>
          <h3>Subscriptions</h3>
        </div>
        <p>
          Implement recurring billing for subscription services, memberships, and SaaS products.
          Includes subscription management, plan changes, and cancellation handling.
        </p>
        <div class="card-features">
          <span class="feature-tag">Recurring payments</span>
          <span class="feature-tag">Plan management</span>
          <span class="feature-tag">Webhooks</span>
        </div>
        <div class="card-buttons">
          <a href="/subs" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-intermediate">Intermediate</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h3>Auth & Capture</h3>
        </div>
        <p>
          Authorize payments first, then capture later. Perfect for inventory management,
          pre-orders, and situations where you need to validate orders before charging.
        </p>
        <div class="card-features">
          <span class="feature-tag">Two-step payment</span>
          <span class="feature-tag">Inventory hold</span>
          <span class="feature-tag">Order validation</span>
        </div>
        <div class="card-buttons">
          <a href="/authcap" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-beginner">Beginner</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-heart"></i>
          </div>
          <h3>Donations</h3>
        </div>
        <p>
          Optimized donation flow for non-profits, charities, and fundraising campaigns.
          Includes donor information collection and recurring donation options.
        </p>
        <div class="card-features">
          <span class="feature-tag">Charity optimized</span>
          <span class="feature-tag">Donor details</span>
          <span class="feature-tag">Tax receipts</span>
        </div>
        <div class="card-buttons">
          <a href="/donate" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-intermediate">Intermediate</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-truck"></i>
          </div>
          <h3>Shipping Integration</h3>
        </div>
        <p>
          Full shipping address collection and validation with real-time shipping options.
          Perfect for physical goods with multiple shipping methods and costs.
        </p>
        <div class="card-features">
          <span class="feature-tag">Address validation</span>
          <span class="feature-tag">Shipping calculator</span>
          <span class="feature-tag">Multi-carrier</span>
        </div>
        <div class="card-buttons">
          <a href="/shipping" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-intermediate">Intermediate</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-file-invoice"></i>
          </div>
          <h3>Invoice System</h3>
        </div>
        <p>
          Create and send professional invoices with PayPal payment integration.
          Includes invoice templates, payment tracking, and automated reminders.
        </p>
        <div class="card-features">
          <span class="feature-tag">Invoice creation</span>
          <span class="feature-tag">Payment tracking</span>
          <span class="feature-tag">Auto reminders</span>
        </div>
        <div class="card-buttons">
          <a href="/invoice" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-advanced">Advanced</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-paper-plane"></i>
          </div>
          <h3>Payout System</h3>
        </div>
        <p>
          Send payments to multiple recipients at once. Perfect for marketplace payouts,
          affiliate commissions, and mass disbursements with compliance tracking.
        </p>
        <div class="card-features">
          <span class="feature-tag">Mass payments</span>
          <span class="feature-tag">Compliance checks</span>
          <span class="feature-tag">Batch processing</span>
        </div>
        <div class="card-buttons">
          <a href="/payout" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>

      <div class="card">
        <div class="difficulty-badge difficulty-advanced">Advanced</div>
        <div class="card-header">
          <div class="card-icon">
            <i class="fas fa-credit-card"></i>
          </div>
          <h3>Braintree Drop-in</h3>
        </div>
        <p>
          Advanced payment UI with Braintree integration supporting multiple payment methods,
          3D Secure, and enhanced fraud protection for enterprise applications.
        </p>
        <div class="card-features">
          <span class="feature-tag">Multi-payment methods</span>
          <span class="feature-tag">3D Secure</span>
          <span class="feature-tag">Fraud protection</span>
        </div>
        <div class="card-buttons">
          <a href="/dropin" target="_blank" class="demo-button">
            <i class="fas fa-play"></i>
            Try Demo
          </a>
        </div>
      </div>
    </div>
  </div>
</body>

</html>